# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env ist in .gitignore und wird NICHT eingecheckt.

# DSBmobile-Zugangsdaten (dieselben wie auf dsbmobile.de)
DSB_USER=
DSB_PASSWORD=

# Telegram: Bot bei @BotFather anlegen -> Token.
# Chat-ID: dem Bot einmal schreiben, dann
#   https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen und "chat":{"id": ...} ablesen.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
